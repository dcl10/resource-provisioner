# Settings and secrets for `docker compose --profile app up -d --build` (see docs/local-development.md).
# Copy to .env (gitignored) and fill in the blanks. Compose reads .env from the repo root by itself.

# ── Keycloak ─────────────────────────────────────────────────────────────────
# The admin console's bootstrap login (http://localhost:8080/admin). Used when Keycloak's database is first created.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# Client secrets Keycloak generates when it imports the realm. Copy them from the admin console:
# realm resource-provisioner -> Clients -> <client> -> Credentials -> Client secret (see docs/auth-setup.md).
KEYCLOAK_WEB_CLIENT_SECRET=
KEYCLOAK_API_CLIENT_SECRET=

# ── Web app ──────────────────────────────────────────────────────────────────
# Encrypts the session cookie. Generate one with: openssl rand -base64 33
AUTH_SECRET=

# ── Claude (the chat agent) ──────────────────────────────────────────────────
# Without a key the app runs, but the agent answers every message with an error.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=low

# ── DigitalOcean (provisioning) ──────────────────────────────────────────────
# A personal access token with write scope. Confirmed requests create real, billed resources with it.
DIGITALOCEAN_TOKEN=
# Spaces access keys, needed only for the Spaces bucket type.
SPACES_ACCESS_ID=
SPACES_SECRET_KEY=

# ── Spend limits ─────────────────────────────────────────────────────────────
LIMITS_MAX_ACTIVE_REQUESTS_PER_USER=3
LIMITS_MAX_ACTIVE_REQUESTS_TOTAL=10
LIMITS_CHAT_MESSAGES_PER_MINUTE=10
