# The host's settings and secrets, as /mnt/rp-data/resource-provisioner/.env (root-only, mode 600).
# On first boot deploy/init-env.sh copies this file there and fills in the hostnames and the generated values; fill in
# the rest by hand. See docs/deployment.md.

# ── Hostnames (filled in from Terraform) ─────────────────────────────────────
APP_HOST=
AUTH_HOST=
# Let's Encrypt's contact for certificate problems.
ACME_EMAIL=

# ── Generated on first boot ──────────────────────────────────────────────────
POSTGRES_APP_PASSWORD=
POSTGRES_KEYCLOAK_PASSWORD=
AUTH_SECRET=
# Keycloak's temporary master-realm admin, used once to create a permanent one; then it's deleted.
KC_BOOTSTRAP_ADMIN_USERNAME=temp-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# ── From Keycloak after its first start (Clients -> <client> -> Credentials) ──
KEYCLOAK_WEB_CLIENT_SECRET=
KEYCLOAK_API_CLIENT_SECRET=

# ── SMTP, for invitation emails ──────────────────────────────────────────────
# Read when Keycloak first imports the realm; later changes are made in the admin console (Realm settings -> Email).
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_AUTH=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false

# ── Claude ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=low

# ── DigitalOcean, for users' resources ───────────────────────────────────────
DIGITALOCEAN_TOKEN=
SPACES_ACCESS_ID=
SPACES_SECRET_KEY=

# ── Spend limits ─────────────────────────────────────────────────────────────
LIMITS_MAX_ACTIVE_REQUESTS_PER_USER=3
LIMITS_MAX_ACTIVE_REQUESTS_TOTAL=10
LIMITS_CHAT_MESSAGES_PER_MINUTE=10
