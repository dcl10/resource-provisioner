# Copy to .env.local and fill in. See docs/auth-setup.md.

# Encrypts the session cookie. Generate one with: npx auth secret
AUTH_SECRET=

# The rp-web Keycloak client. Copy the secret from Clients -> rp-web -> Credentials in the Keycloak admin console.
AUTH_KEYCLOAK_ID=rp-web
AUTH_KEYCLOAK_SECRET=
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/resource-provisioner

# The app's public URL. `npm run dev` works without it, but production builds (`npm run start`, deployed) refuse
# to sign in unless it's set (or AUTH_TRUST_HOST=true).
AUTH_URL=http://localhost:3000

# The .NET API that /api/proxy/* forwards to.
API_URL=http://localhost:5000
