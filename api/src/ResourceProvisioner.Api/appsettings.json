{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Secrets (connection string, API keys, tokens) come from user-secrets locally and environment variables when
  // deployed. Never put them in this file. See docs/architecture.md for the full list.
  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "Keycloak": {
    "AuthServerUrl": "http://localhost:8080",
    "Realm": "resource-provisioner",
    // The API's client ID; access tokens must carry it in "aud". Keycloak:Secret goes in user-secrets.
    "Resource": "rp-api"
  },

  "Invitations": {
    // The web app's URL. Invited users land here after setting their password; it must be a valid redirect URI of
    // the rp-web client.
    "AppUrl": "http://localhost:3000",
    "ClientId": "rp-web",
    "ExpiryDays": 7
  },

  "Anthropic": {
    "Model": "claude-sonnet-5-5",
    // low | medium | high | xhigh | max
    "Effort": "low"
  },

  "Catalog": {
    // One <type>/ folder per resource type. A relative path is looked for in the content root and each folder above
    // it, so "catalog" finds the repo's catalog/ when run from anywhere in the repo.
    "Root": "catalog"
  },

  "Workspaces": {
    // One <requestId>/ folder per request; relative paths resolve from the working directory.
    "Root": "workspaces"
  },

  "Runner": {
    // The Terraform CLI: a path, or a name looked up on PATH.
    "TerraformPath": "terraform",
    // How often GET /api/requests/{id}/logs checks for new lines while a job runs.
    "LogPollInterval": "00:00:01"
  },

  "Limits": {
    "MaxActiveRequestsPerUser": 3,
    "MaxActiveRequestsTotal": 10,
    "ChatMessagesPerMinute": 10
  }
}
