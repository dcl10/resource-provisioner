{
  "id": "test-firewall",
  "displayName": "Test firewall",
  "description": "A fixture resource type with a list of objects. Not a real module.",
  "costHint": "Free: it never runs.",
  "variables": [
    {
      "name": "rules",
      "label": "Inbound rules",
      "type": "array",
      "description": "Inbound rules.",
      "required": true,
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": [
          {
            "name": "protocol",
            "type": "string",
            "description": "tcp or udp.",
            "required": true,
            "allowedValues": ["tcp", "udp"]
          },
          {
            "name": "port",
            "type": "integer",
            "description": "Port number.",
            "required": true,
            "minimum": 1,
            "maximum": 65535
          },
          {
            "name": "sources",
            "type": "array",
            "description": "Source CIDRs.",
            "items": { "type": "string" },
            "default": ["0.0.0.0/0"]
          }
        ]
      }
    },
    {
      "name": "group_request_id",
      "type": "string",
      "description": "The request ID of one of the user's groups, as a droplet's project_request_id.",
      "references": "test-group"
    }
  ],
  "outputs": [
    { "name": "id", "description": "Firewall ID." }
  ]
}
